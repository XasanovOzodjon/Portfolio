[Unit]
Description=Portfolio Django Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app/portfolio
Environment="PATH=/home/ubuntu/app/portfolio/venv/bin"
EnvironmentFile=/home/ubuntu/app/portfolio/.env
ExecStart=/home/ubuntu/app/portfolio/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 core.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
