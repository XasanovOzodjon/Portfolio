[Unit]
Description=Ozodjon Portfolio Web (Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app/portfolio/portfolio-v2
EnvironmentFile=/home/ubuntu/app/portfolio/portfolio-v2/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/ubuntu/app/portfolio/portfolio-v2/venv/bin/gunicorn \
    --access-logfile - \
    --error-logfile - \
    --workers 3 \
    --timeout 60 \
    --bind 127.0.0.1:8009 \
    core.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
