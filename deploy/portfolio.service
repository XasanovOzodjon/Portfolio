[Unit]
Description=Portfolio Django Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app/portfolio
Environment="PATH=/home/ubuntu/app/portfolio/venv/bin"
EnvironmentFile=/home/ubuntu/app/portfolio/.env
ExecStart=/home/ubuntu/app/portfolio/venv/bin/gunicorn --workers 3 --bind unix:/home/ubuntu/app/portfolio/portfolio.sock core.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
